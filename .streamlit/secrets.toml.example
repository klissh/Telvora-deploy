# Streamlit Secrets Configuration Template
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# NEVER commit secrets.toml to version control!

# Backend URL (FastAPI endpoint)
BACKEND_URL = "http://localhost:8000"  # Change to your production URL

# Supabase Configuration
VITE_SUPABASE_URL = "your_supabase_project_url"
VITE_SUPABASE_ANON_KEY = "your_supabase_anon_key"

# Optional: AI Configuration
GEMINI_API_KEY = "your_gemini_api_key"  # Optional for AI insights
OLLAMA_MODEL = "llama2"  # Optional, leave empty to disable AI
OLLAMA_BASE_URL = "http://localhost:11434"  # Optional
OLLAMA_API_KEY = ""  # Optional

# Deployment Notes:
# 1. For Streamlit Cloud: Add these secrets in the Streamlit Cloud dashboard
# 2. For local development: Copy this file to .streamlit/secrets.toml
# 3. Make sure to deploy backend separately (Railway, Render, etc)
# 4. Update BACKEND_URL to your production backend URL
